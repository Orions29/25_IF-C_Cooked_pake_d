   "source": [
    "zone = pd.read_parquet(\"../datasets/zone/taxi_zone.parquet\")\n",
    "zone = zone.rename(columns={\"Zone\": \"zone_name\", \"Borough\": \"borough\"})\n",
    "\n",
    "nama = zone[\"zone_name\"].str.lower()\n",
    "zone[\"is_airport\"] = ((zone[\"borough\"].str.lower() == \"ewr\") | nama.str.contains(\"airport|newark|jfk|laguardia\", regex=True)).astype(int)\n",
    "zone[\"is_cbd\"] = (zone[\"borough\"].str.lower() == \"manhattan\").astype(int)\n",
    "\n",
    "zone_centroid = zone[[\"LocationID\", \"longitude\", \"latitude\", \"zone_name\", \"borough\", \"is_airport\", \"is_cbd\"]].copy()\n",
    "zone_centroid.to_csv(\"../datasets/zone/zone_centroid_lookup.csv\", index=False)\n",
    "\n",
    "print(\"Jumlah zona:\", len(zone_centroid))\n",
    "print(\"Zona tanpa koordinat:\", int(zone_centroid[\"longitude\"].isna().sum()))\n",
    "print(\"Satu zona satu record:\", zone_centroid[\"LocationID\"].is_unique)\n",
    "display(zone_centroid.head(10))"
   ]
  },
