   "source": [
    "lookup = zone_centroid.set_index(\"LocationID\")\n",
    "kolom_zona = [\"longitude\", \"latitude\", \"zone_name\", \"borough\", \"is_airport\", \"is_cbd\"]\n",
    "\n",
    "df_all = df_all.reset_index(drop=True)  # index rapi biar concat tidak geser\n",
    "n_sebelum = len(df_all)\n",
    "\n",
    "pu = df_all[[\"PULocationID\"]].join(lookup[kolom_zona], on=\"PULocationID\").add_prefix(\"PU_\").drop(columns=[\"PU_PULocationID\"])\n",
    "do = df_all[[\"DOLocationID\"]].join(lookup[kolom_zona], on=\"DOLocationID\").add_prefix(\"DO_\").drop(columns=[\"DO_DOLocationID\"])\n",
    "\n",
    "df_main = pd.concat([df_all, pu, do], axis=1)\n",
    "\n",
    "print(f\"Baris sebelum join: {n_sebelum:,}, setelah join: {len(df_main):,}\")\n",
    "print(\"Koordinat pickup kosong:\", int(df_main[\"PU_longitude\"].isna().sum()))\n",
    "print(\"Koordinat dropoff kosong:\", int(df_main[\"DO_longitude\"].isna().sum()))"
