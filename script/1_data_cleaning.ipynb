    "         \"DO_zone_name\", \"DO_borough\", \"DO_is_airport\", \"DO_is_cbd\"]\n",
    "sisa = [c for c in df_main.columns if c not in depan + [\"_bulan\"]]\n",
    "df_main = df_main[depan + sisa + [\"_bulan\"]]\n",
